# Copy this file to .dev.vars. Wrangler loads it for local development.
# Required for Google owner login and the signed session cookie.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
ALLOWED_EMAIL=owner@example.com
SESSION_SECRET=replace-with-a-long-random-secret

# Optional: further pin the allowed Google account to its stable subject ID.
# ALLOWED_SUB=google-account-subject

# Required only when invoking operational /alerts/run/* endpoints.
API_SECRET=replace-with-an-operational-secret

# Optional integrations.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
FSC_STOCK_API_SERVICE_KEY=your-stock-api-key
FSC_STOCK_API_BASE_URL=https://apis.data.go.kr/1160100/service/GetStockSecuritiesInfoService
FSC_SECURITIES_PRODUCT_API_BASE_URL=https://apis.data.go.kr/1160100/service/GetSecuritiesProductInfoService
