{
  "name": "@gokkan-keeper/web",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ./scripts/ensure-build-env.mjs production && node ./scripts/generate-seo-files.mjs && tsc && vite build && pnpm run build:pages-worker",
    "build:prod": "node ./scripts/ensure-build-env.mjs production && node ./scripts/generate-seo-files.mjs && tsc && vite build --mode production && pnpm run build:pages-worker",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.server.json && tsc --project tsconfig.node.json",
    "deploy": "node ../../scripts/deploy.mjs web",
    "deploy:prod": "node ../../scripts/deploy.mjs web",
    "cap:sync": "cap sync",
    "cap:ios": "cap open ios",
    "cap:android": "cap open android",
    "build:pages-worker": "tsc --project tsconfig.server.json && node ./scripts/build-pages-worker.mjs"
  },
  "dependencies": {
    "@gokkan-keeper/shared": "workspace:*",
    "pretendard": "^1.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "wrangler": "^4.148.0"
  }
}
